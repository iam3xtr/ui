{
  "name": "@iam3xtr/ui",
  "version": "0.1.1",
  "description": "Visual foundation for 3xtr.im applications",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json",
    "./styles/tokens.scss": "./src/styles/tokens.scss",
    "./styles/tokens.css": "./dist/tokens.css",
    "./styles/theme.scss": "./src/styles/theme.scss",
    "./styles/theme.css": "./dist/theme.css",
    "./assets/*": "./src/assets/*"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "lint:style": "stylelint \"src/**/*.scss\"",
    "pretest": "npm run build",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "bulma": "^1.0.0",
    "buefy": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "bulma": {
      "optional": true
    },
    "buefy": {
      "optional": true
    }
  },
  "devDependencies": {
    "bulma": "^1.0.4",
    "buefy": "^3.0.8",
    "postcss-scss": "^4.0.9",
    "sass": "^1.101.0",
    "stylelint": "^17.14.1",
    "stylelint-config-recommended": "^18.0.0",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iam3xtr/ui.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  }
}
